BROWSERBASE_API_KEY=
ELEVENLABS_API_KEY=
OPENAI_API_KEY=
GPTZERO_API_KEY=
# Google Fact Check Tools API key — matches claims to existing human fact-checks.
# GOOGLE_FACTCHECK_API_KEY=
# FRED (St. Louis Fed) API key — official figures for economic claims.
# FRED_API_KEY=
# Optional: Slack-compatible incoming webhook that alerts are posted to.
# ALERT_WEBHOOK_URL=
# AI probability (0-1) at or above which a scored speech alerts. Default 0.8.
# ALERT_AI_THRESHOLD=0.8
# Postgres connection string. Tables are created automatically on first query.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/speech_ingest
# OPENAI_MODEL=gpt-5-mini
# Optional: path to a yt-dlp binary for excerpt extraction. Falls back to
# ./bin/yt-dlp, then `yt-dlp` on PATH. `ffmpeg` must also be on PATH.
# YT_DLP_PATH=/usr/local/bin/yt-dlp
# Optional: gate the whole app behind a shared token. Leave unset for local dev;
# set it before exposing the app so anonymous callers cannot spend your provider
# keys or read/delete your data. Visit any page with `?token=<token>` once to set
# the cookie, or send it as `x-app-token` / `Authorization: Bearer`.
# APP_ACCESS_TOKEN=
